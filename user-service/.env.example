# Local development outside Docker (`cargo run -- serve`, `cargo test`, `cargo sqlx prepare`).
# Copy to .env and fill in the passwords from the root .env. Never commit .env.
#
# sqlx's query macros read DATABASE_URL from this file at compile time. The binary
# itself does not load .env, so export it before `cargo run -- serve`: `set -a; source .env; set +a`.
# Every setting can also be passed as a flag: `cargo run -- serve --help` lists them.
# In docker compose these are set in docker-compose.yml instead.

# --- Required ---
DATABASE_URL=postgres://users:<USERS_DB_PASSWORD>@localhost:5432/users
# Oathkeeper -> /internal/hydrate (basic auth)
HYDRATOR_PASSWORD=<HYDRATOR_PASSWORD>
# Kratos web hook -> /internal/kratos/identity (basic auth)
KRATOS_WEBHOOK_PASSWORD=<KRATOS_WEBHOOK_PASSWORD>

# --- Optional (defaults target the compose network, so override them for localhost) ---
JWKS_URL=http://localhost:4456/.well-known/jwks.json
# JWT_ISSUER=http://localhost:8080/
KRATOS_ADMIN_URL=http://localhost:4434
# PUBLIC_ADDR=0.0.0.0:3000
# INTERNAL_ADDR=0.0.0.0:3001
# DB_MAX_CONNECTIONS=10

# RUST_LOG=info,user_service=debug,sqlx=warn
