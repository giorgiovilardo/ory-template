# Copy to .env with `just init` (which also generates random secrets). Never commit .env.

# --- Secrets (generated by `just init`) ---
POSTGRES_PASSWORD=__RANDOM_HEX_16__
KRATOS_SECRET_COOKIE=__RANDOM_HEX_32__
# Must be exactly 32 characters.
KRATOS_SECRET_CIPHER=__RANDOM_HEX_16__
UI_COOKIE_SECRET=__RANDOM_HEX_32__
UI_CSRF_COOKIE_SECRET=__RANDOM_HEX_32__
USERS_DB_PASSWORD=__RANDOM_HEX_16__
# Oathkeeper -> user-service /internal/hydrate (basic auth)
HYDRATOR_PASSWORD=__RANDOM_HEX_32__

# --- Social login (leave blank to disable) ---
# After changing these: docker compose up -d kratos
#
# Google: https://console.cloud.google.com/apis/credentials -> OAuth client ID -> Web application
#   Authorized redirect URI: http://localhost:4433/self-service/methods/oidc/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers -> New OAuth App
#   Authorization callback URL: http://localhost:4433/self-service/methods/oidc/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
